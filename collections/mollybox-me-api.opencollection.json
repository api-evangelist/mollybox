{
  "opencollection": "1.0.0",
  "info": {
    "name": "Arcflow Admin Me API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Me",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Identity",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/me",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Return the authenticated server identity."
        }
      ]
    }
  ],
  "bundled": true
}